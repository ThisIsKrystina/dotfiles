# SHELL SETTINGS

# Global helper scripts
source ~/Projects/_active/dotfiles/bin/01-helpers.sh

# Default options
shopt -s autocd # open a directory without cd
shopt -s cdspell # fix typos on cd command
shopt -s globskipdots # expand ../
shopt -s globstar # Makes */** work
shopt -s inherit_errexit
shopt -s nocaseglob # glob patterns case insensitive
shopt -s expand_aliases
shopt -s progcomp

if [[ -f ~/.bash_aliases ]]; then
  source ~/.bash_aliases
fi

# Secure ShellFish rc is different per machine (Chezmoi doesn't touch it)
[ -r ~/.shellfishrc ] && source ~/.shellfishrc

# ======== MOBILE SETTINGS
# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Load the rest of .bashrc configs
if [ -d "$HOME/.bashrc.d" ]; then
    for config in "$HOME/.bashrc.d"/*.bashrc; do
        [ -r "$config" ] && source "$config"
    done
fi

# Load bin scripts (dir + extension, don't need glob). Skip 01-helpers.sh —
# it's already sourced at the top of this file.
src_dir ~/Projects/_active/dotfiles/bin sh 01-helpers.sh
src_dir ~/.local/lib sh
