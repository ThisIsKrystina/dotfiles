{{ if eq .chezmoi.os "darwin" -}}
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config


# macOS-only keywords (UseKeychain) — tell non-mac ssh to skip them instead of erroring
IgnoreUnknown UseKeychain

Host pipi {{ onepasswordRead "op://pipi/Pipi/Admin Console/hostname" }}
HostName {{ onepasswordRead "op://pipi/Pipi/Local/ip address"}}
User {{ onepasswordRead "op://pipi/Pipi/Admin Console/admin console username"}}
Port {{ onepasswordRead "op://pipi/Pipi/Local/port"}}
IdentityFile ~/.ssh/mbp_remote_to_pipi
ForwardAgent yes


Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host github.com
    Hostname ssh.github.com
    Port 443
    User git

Host github-sign
HostName github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/github_sign

Host github-auth
HostName github.com
AddKeysToAgent yes
UseKeychain yes
IdentityFile ~/.ssh/github_auth

{{ else if eq .chezmoi.os "linux" -}}
{{ template "pi_ssh_config" }}
{{- end -}}
