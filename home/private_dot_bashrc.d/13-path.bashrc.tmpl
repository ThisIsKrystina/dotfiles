# ===== ANYTHING THAT NEEDS EXPORTING TO PATH =====

# Add local bin to PATH so you can run local scripts bc that's not default for some reason??
export PATH="$HOME{{ .chezmoi.pathSeparator }}.local{{ .chezmoi.pathSeparator }}bin{{ .chezmoi.pathListSeparator }}$PATH"

# Use normal names instead of g+ for coreutils
export PATH="{{ .brew_prefix }}{{ .chezmoi.pathSeparator }}opt{{ .chezmoi.pathSeparator }}coreutils{{ .chezmoi.pathSeparator }}libexec{{ .chezmoi.pathSeparator }}gnubin{{ .chezmoi.pathListSeparator }}$PATH"

# Use normal "grep" instead of "ggrep"
PATH="{{ .brew_prefix }}{{ .chezmoi.pathSeparator }}opt{{ .chezmoi.pathSeparator }}grep{{ .chezmoi.pathSeparator }}libexec{{ .chezmoi.pathSeparator }}gnubin{{ .chezmoi.pathListSeparator }}$PATH"


# PIP
export PATH="$PATH{{ .chezmoi.pathListSeparator }}{{ .chezmoi.pathSeparator }}usr{{ .chezmoi.pathSeparator }}local{{ .chezmoi.pathSeparator }}bin{{ .chezmoi.pathSeparator }}pip3"

# Ffmpeg
export PATH="$PATH{{ .chezmoi.pathListSeparator }}{{ .brew_bin }}{{ .chezmoi.pathSeparator }}ffmpeg"

# bun 
export BUN_INSTALL="$HOME{{ .chezmoi.pathSeparator }}.bun"
export PATH="$BUN_INSTALL{{ .chezmoi.pathSeparator }}bin{{ .chezmoi.pathListSeparator }}$PATH"

# Git Filter Repo if you really fucked up your commits
export PATH="$PATH{{ .chezmoi.pathListSeparator }}{{ .brew_bin }}{{ .chezmoi.pathSeparator }}{{ .chezmoi.config.git.command }}-filter-repo"

# Copy SSH ID
export PATH="{{ .brew_prefix }}{{ .chezmoi.pathSeparator }}opt{{ .chezmoi.pathSeparator }}ssh-copy-id{{ .chezmoi.pathSeparator }}bin{{ .chezmoi.pathListSeparator }}$PATH"# Virtualenvwrapper for Python if installed
if command -v virtualenvwrapper.sh >{{ .chezmoi.pathSeparator }}dev{{ .chezmoi.pathSeparator }}null 2>&1; then
    source "$(command -v virtualenvwrapper.sh)"
fi


# Ruby gem commands
export PATH="{{ .brew_prefix }}{{ .chezmoi.pathSeparator }}lib{{ .chezmoi.pathSeparator }}{{ .chezmoi.config.interpreters.rb.command }}{{ .chezmoi.pathSeparator }}gems{{ .chezmoi.pathSeparator }}4.0.0{{ .chezmoi.pathSeparator }}bin{{ .chezmoi.pathListSeparator }}$PATH"
