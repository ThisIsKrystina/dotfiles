# Source: https://bash-prompt.net/guides/nanorc-settings/


# UI
set constantshow # Displays useful information e.g. line number and position in the bottom bar.
set minibar # Moves helpful info to to the bottom
set indicator       # Displays a scroll bar on the right that shows the position and size of the current view port.
set linenumbers # Lines are numbered. You want this for error messages.

# Editor annoyances
set zap # Allows you to highlight text (CTRL+SHIFT+ARROW) and delete it with backspace.
set cutfromcursor # CTRL+K cuts from cursor position to end of line.
set mouse 

set smarthome

# Formatting
set autoindent # new lines will match indent of previous line
set tabsize 2
set softwrap
include "/usr/local/share/nano/*.nanorc" # Turn on syntax highlighting
include "{.brew_prefix}/Cellar/nano/*/share/nano/*.nanorc"
# set tabstospaces    # Converts TAB key press to spaces.
#set speller "aspell -x -c"         # Sets what spelling utility to use.

# Set a working backup directory
set backup                              # Creates backups of your current file.
set backupdir "~/.cache/nano/backups/"  # The location of the backups.


# Misc
set casesensitive off # Case insensitive search.

# Custom keybindings
bind ^C copy main
bind ^V paste main
bind ^Y undo main
bind ^E redo main
bind ^K cut main
# set modernbindings








